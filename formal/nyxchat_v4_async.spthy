/*
 * NyxChat asynchronous session initiation -- Tamarin model
 * =======================================================
 *
 * Part 1 models Handshake.asyncInitiate / Handshake.asyncRespond as driven
 * by SessionManager.encrypt / SessionManager.decrypt (lib/core/crypto/),
 * in both variants: encapsulating to a one-time ML-KEM prekey of B that B
 * registered with A over an authenticated link (PrekeyStore,
 * PrekeyExchange), and the last-resort fallback to B's long-term KEM key.
 * Part 2 models the concurrent-initiation collision rule of
 * SessionManager.decrypt with two fixed parties whose handles are ordered.
 *
 *   A -> B : 'init_opk', A, EK_A, kct, senc('session-open', mk)
 *   kct  = KEM.Encaps(OPK_B) carrying fresh secret kem     (prekey path)
 *   root = kdf('NyxChat_Async_Prekey_Session_v4', OPK_B, dh1, dh2, kem)
 *
 *   A -> B : 'init', A, EK_A, kct, senc('session-open', mk)
 *   kct  = KEM.Encaps(KPK_B) carrying fresh secret kem     (fallback)
 *   root = kdf('NyxChat_Async_Session_v3', dh1, dh2, kem)
 *
 *   dh1 = DH(IK_A, IK_B)   dh2 = DH(EK_A, IK_B)
 *   mk  = kdf('NyxChat_DR_Root_v3', root)        (first Double Ratchet message key, abstracted)
 *
 * The prekey's private half is a linear fact that B consumes when it
 * accepts (PrekeyStore.deleteOwn after the first decrypt) and that the
 * reveal rule consumes too, so a prekey cannot both be used and later
 * leaked: that is what gives the prekey path post-quantum forward secrecy
 * (lemma async_pq_forward_secrecy) that the fallback lacks
 * (async_secrecy_responder).
 *
 * B holds A's pinned IK/KPK (the !Pk lookup by the sender handle carried in
 * the envelope), derives root with its private IK/KPK and accepts only if
 * the first message decrypts. The Double Ratchet itself is not modelled:
 * the first message key is abstracted as a KDF of root (the real one also
 * mixes DH(ratchet key, IK_B); this does not change who can compute it).
 *
 * NOTE: the code labels these derivations "v3" ('NyxChat-Async-Session-v3');
 * docs call the protocol v4. See formal/README.md.
 *
 * Machine-checked with Tamarin 1.12.0 / Maude 3.5.1; outcomes, timings and
 * the command lines are in formal/RESULTS.md. Reproduce with
 * tool/prove_formal.sh or  tamarin-prover --prove formal/nyxchat_v4_async.spthy
 */

theory NyxChat_Async
begin

builtins: diffie-hellman, signing, hashing, symmetric-encryption

functions: kdf/1, kempk/1, kemenc/2, kemdec/2
equations: kemdec(kemenc(kempk(k), r), k) = r

/* ------------------------------------------------------------------ */
/* Restrictions                                                        */
/* ------------------------------------------------------------------ */

restriction Equality:
  "All x y #i. Eq(x, y) @i ==> x = y"

restriction Inequality:
  "All x #i. Neq(x, x) @i ==> F"

restriction UniqueKeys:
  "All A #i #j. KeyGen(A) @i & KeyGen(A) @j ==> #i = #j"

/* The two-party collision world is set up exactly once. */
restriction OnlyOnce:
  "All x #i #j. OnlyOnce(x) @i & OnlyOnce(x) @j ==> #i = #j"

/* ------------------------------------------------------------------ */
/* PART 1: asynchronous initiation between arbitrary pinned contacts   */
/* ------------------------------------------------------------------ */

rule Register_Keys:
  [ Fr(~ik), Fr(~sk), Fr(~kk) ]
  --[ KeyGen($A) ]->
  [ !Ltk($A, ~ik, ~sk, ~kk)
  , !Pk($A, 'g'^~ik, pk(~sk), kempk(~kk))
  , Out(<'g'^~ik, pk(~sk), kempk(~kk)>) ]

rule Reveal_LTK:
  [ !Ltk($A, ~ik, ~sk, ~kk) ]
  --[ RevealLTK($A) ]->
  [ Out(<~ik, ~sk, ~kk>) ]

rule Reveal_KEM_Key:
  [ !Ltk($A, ~ik, ~sk, ~kk) ]
  --[ RevealKPK($A) ]->
  [ Out(~kk) ]

rule Reveal_DH_Identity:
  [ !Ltk($A, ~ik, ~sk, ~kk) ]
  --[ RevealDH($A) ]->
  [ Out(~ik) ]

rule Reveal_DH_Ephemeral:
  [ !Eph($A, ~ek) ]
  --[ RevealDH($A) ]->
  [ Out(~ek) ]

/* One-time prekeys. B generates an ML-KEM key pair for A and hands the
 * public half to A inside an authenticated, encrypted direct link
 * (PrekeyBundle: Ed25519-signed by B, verified by A against its pin of B,
 * replay-rejected by issue time). That channel is modelled as direct state
 * transfer: A's copy OPKPub is exactly what B generated and the adversary
 * cannot insert or alter one. Both halves are linear facts: A consumes
 * its copy when it initiates (PrekeyStore.takePeerPrekey), B consumes,
 * i.e. deletes, the private half when it accepts (PrekeyStore.deleteOwn).
 * The public half is also published, which only helps the adversary. */
rule Register_Prekey:
  [ !Ltk($B, ~ikB, ~skB, ~kkB), !Ltk($A, ~ikA, ~skA, ~kkA), Fr(~opk) ]
  --[ Neq($A, $B), RegisterOPK($B, $A, kempk(~opk)) ]->
  [ OPK($B, $A, ~opk), OPKPub($A, $B, kempk(~opk)), Out(kempk(~opk)) ]

/* Compromise of an unused prekey's private half, the only time it exists
 * (after use it is deleted). Consuming the fact means the same prekey
 * cannot also be accepted with afterwards. */
rule Reveal_OPK:
  [ OPK($B, $A, ~opk) ]
  --[ RevealOPK($B, kempk(~opk)) ]->
  [ Out(~opk) ]

/* Machine-checking note (Tamarin 1.12.0, see formal/RESULTS.md). Every
 * rule that exponentiates a pinned X25519 public key taken from !Pk or
 * !CPk matches it with its only possible shape 'g'^~ik (Register_Keys and
 * Collision_Setup are the sole producers of those facts), so the pattern
 * excludes no rule instance. With a free variable there Tamarin
 * enumerated hundreds of AC variants per rule and precomputation took
 * eight minutes; with the pattern it takes about twenty seconds.
 * [no_derivcheck] disables Tamarin's "unintended pattern matching"
 * heuristic for those rules, which would otherwise report the private
 * exponent ~ik as not derivable from the premises. */

/* SessionManager.encrypt with no session and pinned keys for $B:
 * Handshake.asyncInitiate, DoubleRatchetSession.initAlice, and the first
 * envelope carrying the SessionInitBlock (EK_A, kct). */
rule Async_Initiate [no_derivcheck]:
  let pkIKB = 'g'^~ikB   /* pinned-key shape, see the machine-checking note above */
      dh1  = pkIKB^~ikA
      ekA  = 'g'^~ekA
      dh2  = pkIKB^~ekA
      kct  = kemenc(pkKPKB, ~kem)
      root = kdf(<'NyxChat_Async_Session_v3', dh1, dh2, ~kem>)
      mk   = kdf(<'NyxChat_DR_Root_v3', root>)
  in
  [ !Ltk($A, ~ikA, ~skA, ~kkA)
  , !Pk($B, pkIKB, pkSKB, pkKPKB)
  , Fr(~ekA), Fr(~kem) ]
  --[ Neq($A, $B)
    , AsyncInit($A, $B, root)
    , AsyncRunningI($A, $B, ekA, kct, root)
    , AsyncKey($A, $B, root)
    , Honest($A), Honest($B) ]->
  [ Out(<'init', $A, ekA, kct, senc('session_open', mk)>)
  , !Eph($A, ~ekA) ]

/* SessionManager.decrypt with an init block and no usable session:
 * Handshake.asyncRespond with B's private IK/KPK and A's pinned IK, then
 * DoubleRatchetSession.initBob and a decryption that must succeed before
 * the session is saved (commit-on-success). */
rule Async_Respond [no_derivcheck]:
  let pkIKA = 'g'^~ikA   /* pinned-key shape, see the machine-checking note above */
      dh1  = pkIKA^~ikB
      dh2  = ekA^~ikB
      kem  = kemdec(kct, ~kkB)
      root = kdf(<'NyxChat_Async_Session_v3', dh1, dh2, kem>)
      mk   = kdf(<'NyxChat_DR_Root_v3', root>)
  in
  [ !Ltk($B, ~ikB, ~skB, ~kkB)
  , !Pk($A, pkIKA, pkSKA, pkKPKA)
  , In(<'init', $A, ekA, kct, c>) ]
  --[ Eq(sdec(c, mk), 'session_open')
    , Neq($A, $B)
    , AsyncAccept($B, $A, root)
    , AsyncCommitR($B, $A, ekA, kct, root)
    , AsyncKey($B, $A, root)
    , Honest($A), Honest($B) ]->
  [ ]

/* SessionManager.encrypt with a prekey of $B on file: Handshake.asyncInitiate
 * with prekeyId/prekeyPublicKey encapsulates to the prekey, the root uses
 * the prekey label with the prekey (id) as salt, and the SessionInitBlock
 * carries the id (`pk`); in the model B selects the prekey by trying its
 * own OPK facts, which the Eq check on the first message disambiguates.
 * The prekey is used once: OPKPub is consumed. */
rule Async_Initiate_OPK [no_derivcheck]:
  let pkIKB = 'g'^~ikB   /* pinned-key shape, see the machine-checking note above */
      dh1  = pkIKB^~ikA
      ekA  = 'g'^~ekA
      dh2  = pkIKB^~ekA
      kct  = kemenc(pkOPK, ~kem)
      root = kdf(<'NyxChat_Async_Prekey_Session_v4', pkOPK, dh1, dh2, ~kem>)
      mk   = kdf(<'NyxChat_DR_Root_v3', root>)
  in
  [ !Ltk($A, ~ikA, ~skA, ~kkA)
  , !Pk($B, pkIKB, pkSKB, pkKPKB)
  , OPKPub($A, $B, pkOPK)
  , Fr(~ekA), Fr(~kem) ]
  --[ Neq($A, $B)
    , AsyncInitOPK($A, $B, root, pkOPK)
    , AsyncRunningI($A, $B, ekA, kct, root)
    , Honest($A), Honest($B) ]->
  [ Out(<'init_opk', $A, ekA, kct, senc('session_open', mk)>)
  , !Eph($A, ~ekA) ]

/* SessionManager.decrypt with an init block naming one of our prekeys
 * (PrekeyStore.findOwn): Handshake.asyncRespond with the prekey's private
 * half, DoubleRatchetSession.initBob, decrypt, and only then
 * PrekeyStore.deleteOwn. The OPK fact is consumed by this rule, so the
 * private half is gone exactly when a session was accepted with it (a rule
 * instance whose Eq fails is not part of any trace). An init naming a
 * prekey we do not hold matches no rule: the code raises
 * UnknownPrekeyException, signs a notice, and the initiator restarts
 * through Async_Initiate (the fallback). */
rule Async_Respond_OPK [no_derivcheck]:
  let pkIKA = 'g'^~ikA   /* pinned-key shape, see the machine-checking note above */
      dh1   = pkIKA^~ikB
      dh2   = ekA^~ikB
      pkOPK = kempk(~opk)
      kem   = kemdec(kct, ~opk)
      root  = kdf(<'NyxChat_Async_Prekey_Session_v4', pkOPK, dh1, dh2, kem>)
      mk    = kdf(<'NyxChat_DR_Root_v3', root>)
  in
  [ !Ltk($B, ~ikB, ~skB, ~kkB)
  , !Pk($A, pkIKA, pkSKA, pkKPKA)
  , OPK($B, $A, ~opk)
  , In(<'init_opk', $A, ekA, kct, c>) ]
  --[ Eq(sdec(c, mk), 'session_open')
    , Neq($A, $B)
    , AsyncAcceptOPK($B, $A, root, pkOPK)
    , AsyncCommitR($B, $A, ekA, kct, root)
    , UsedOPK($B, $A, pkOPK)
    , Honest($A), Honest($B) ]->
  [ ]


/* ------------------------------------------------------------------ */
/* PART 2: concurrent-initiation collision rule (SessionManager.decrypt) */
/* ------------------------------------------------------------------ */
/* Two fixed parties named by their handles 'a' < 'b'. Each keeps one
 * state fact per peer: Idle (no session), Pending(root, ek) (initiated
 * with ephemeral ek, pendingInit set, no reply seen yet) or
 * Final(root, ab) (settled; ab is the ephemeral of the init this party
 * abandoned when it lost a collision, SessionRecord.abandonedInitEph, or
 * 'none'). The adversary controls the network but holds no private key in
 * this sub-model; it can delay, reorder, replay and drop. Reveal rules
 * above do not apply here (separate !CLtk facts).
 *
 * Blacklist (SessionRecord.ignoredInitEphs): the action Ignored(X, Y, e)
 * marks every point where the code appends e to the list; the action
 * NotIgnored(X, Y, e) marks the rules that would derive a session from an
 * init with ephemeral e; the restriction below forbids the latter after
 * the former. Being action history, the list is automatically carried
 * over when a session is replaced (the code copies it explicitly). The
 * real list keeps 8 entries; the model keeps all.
 *
 * Abandoned-init announcement: a party that loses a collision stores the
 * ephemeral of its own pending init and sends it with every message
 * ('ab' field) until it receives a message without an init block from the
 * winner; a receiver records every 'ab' it sees on a successful fast-path
 * decrypt. 'ab' is modelled INSIDE the authenticated payload; the code
 * sends it as a plaintext envelope field that Envelope.associatedDataFor
 * binds into the AEAD associated data of every envelope (length-prefixed,
 * empty when absent), which is the equivalent -- see README, finding 6. */

restriction IgnoredInitsDropped:
  "All X Y e #i #j. NotIgnored(X, Y, e) @i & Ignored(X, Y, e) @j & #j < #i ==> F"

rule Collision_Setup:
  [ Fr(~ika), Fr(~kka), Fr(~ikb), Fr(~kkb) ]
  --[ OnlyOnce('collision_setup') ]->
  [ !CLtk('a', ~ika, ~kka), !CPk('a', 'g'^~ika, kempk(~kka))
  , !CLtk('b', ~ikb, ~kkb), !CPk('b', 'g'^~ikb, kempk(~kkb))
  , !Less('a', 'b')
  , Idle('a', 'b'), Idle('b', 'a')
  , Out(<'g'^~ika, kempk(~kka), 'g'^~ikb, kempk(~kkb)>) ]

/* SessionManager.encrypt with no session: start an async session and
 * remember it as pendingInit (attached to every envelope until a reply). */
rule C_Initiate [no_derivcheck]:
  let pkIKY = 'g'^~ikY   /* pinned-key shape, see the machine-checking note above */
      dh1  = pkIKY^~ikX
      ekX  = 'g'^~ekX
      dh2  = pkIKY^~ekX
      kct  = kemenc(pkKPKY, ~kem)
      root = kdf(<'NyxChat_Async_Session_v3', dh1, dh2, ~kem>)
      mk   = kdf(<'NyxChat_DR_Root_v3', root>)
  in
  [ Idle(X, Y), !CLtk(X, ~ikX, ~kkX), !CPk(Y, pkIKY, pkKPKY), Fr(~ekX), Fr(~kem) ]
  --[ CInit(X, Y, root) ]->
  [ Pending(X, Y, root, ekX)
  , Out(<'init', X, ekX, kct, senc('session_open', mk)>) ]

/* decrypt(): no session, init block present -> respond and adopt. */
rule C_Adopt_From_Idle [no_derivcheck]:
  let pkIKY = 'g'^~ikY   /* pinned-key shape, see the machine-checking note above */
      dh1  = pkIKY^~ikX
      dh2  = ekY^~ikX
      kem  = kemdec(kct, ~kkX)
      root = kdf(<'NyxChat_Async_Session_v3', dh1, dh2, kem>)
      mk   = kdf(<'NyxChat_DR_Root_v3', root>)
  in
  [ Idle(X, Y), !CLtk(X, ~ikX, ~kkX), !CPk(Y, pkIKY, pkKPKY)
  , In(<'init', Y, ekY, kct, c>) ]
  --[ Eq(sdec(c, mk), 'session_open'), Adopted(X, Y, root) ]->
  [ Final(X, Y, root, 'none') ]

/* decrypt(): own init pending AND incoming init AND my handle is smaller
 * -> record the ignored ephemeral, SessionCollisionException, keep my
 * session (state otherwise unchanged). */
rule C_Collision_Ignore:
  [ Pending(X, Y, root, ekX), !Less(X, Y), In(<'init', Y, ekY, kct, c>) ]
  --[ CollisionIgnored(X, Y), Ignored(X, Y, ekY), Adopted(X, Y, root) ]->
  [ Pending(X, Y, root, ekX) ]

/* decrypt(): own init pending AND incoming init AND my handle is larger
 * -> derive the peer's session, adopt it if the message decrypts, and
 * remember my own abandoned ephemeral to announce it. */
rule C_Collision_Adopt [no_derivcheck]:
  let pkIKY = 'g'^~ikY   /* pinned-key shape, see the machine-checking note above */
      dh1   = pkIKY^~ikX
      dh2   = ekY^~ikX
      kem   = kemdec(kct, ~kkX)
      root2 = kdf(<'NyxChat_Async_Session_v3', dh1, dh2, kem>)
      mk    = kdf(<'NyxChat_DR_Root_v3', root2>)
  in
  [ Pending(X, Y, root, ekX), !Less(Y, X), !CLtk(X, ~ikX, ~kkX), !CPk(Y, pkIKY, pkKPKY)
  , In(<'init', Y, ekY, kct, c>) ]
  --[ Eq(sdec(c, mk), 'session_open'), NotIgnored(X, Y, ekY)
    , Abandoned(X, Y, ekX), Adopted(X, Y, root2) ]->
  [ Final(X, Y, root2, ekX) ]

/* A settled party sends a message (no init block) under its session,
 * carrying its abandoned ephemeral ('ab') while it has one. */
rule C_Reply:
  [ Final(X, Y, root, ab) ]
  --[ Replied(X, Y, root, ab) ]->
  [ Final(X, Y, root, ab), Out(senc(<'reply', ab>, kdf(<'NyxChat_DR_Reply', root>))) ]

/* decrypt() fast path for a pending initiator: a message from the peer
 * under its own session clears pendingInit (session confirmed) and
 * blacklists the announced abandoned ephemeral. */
rule C_Confirm:
  [ Pending(X, Y, root, ekX), In(senc(<'reply', ab>, kdf(<'NyxChat_DR_Reply', root>))) ]
  --[ Confirmed(X, Y, root), Ignored(X, Y, ab), Adopted(X, Y, root) ]->
  [ Final(X, Y, root, 'none') ]

/* decrypt() fast path for a settled party: a message without an init
 * block proves the peer has heard from us, so our own announcement stops
 * (abandonedInitEph cleared); the peer's announcement is blacklisted. */
rule C_Recv_Reply_Final:
  [ Final(X, Y, root, ab), In(senc(<'reply', ab2>, kdf(<'NyxChat_DR_Reply', root>))) ]
  --[ Ignored(X, Y, ab2), AbCleared(X, Y) ]->
  [ Final(X, Y, root, 'none') ]

/* decrypt() recovery path: a settled session (pendingInit == null) that
 * receives an init block with a new ephemeral that is not blacklisted
 * re-derives and REPLACES its session if the message decrypts. Meant for
 * a peer that lost its state. The blacklist is carried over. */
rule C_Recover [no_derivcheck]:
  let pkIKY = 'g'^~ikY   /* pinned-key shape, see the machine-checking note above */
      dh1   = pkIKY^~ikX
      dh2   = ekY^~ikX
      kem   = kemdec(kct, ~kkX)
      root2 = kdf(<'NyxChat_Async_Session_v3', dh1, dh2, kem>)
      mk    = kdf(<'NyxChat_DR_Root_v3', root2>)
  in
  [ Final(X, Y, root, ab), !CLtk(X, ~ikX, ~kkX), !CPk(Y, pkIKY, pkKPKY)
  , In(<'init', Y, ekY, kct, c>) ]
  --[ Eq(sdec(c, mk), 'session_open'), NotIgnored(X, Y, ekY)
    , Recover(X, Y, ekY), Adopted(X, Y, root2) ]->
  [ Final(X, Y, root2, 'none') ]
/* ------------------------------------------------------------------ */
/* Lemmas: asynchronous initiation                                     */
/* ------------------------------------------------------------------ */

/* Sanity: an honest async initiation is accepted with the same root. */
lemma async_executable:
  exists-trace
  "Ex A B r #i #j.
     AsyncInit(A, B, r) @i & AsyncAccept(B, A, r) @j & #i < #j
   & not (Ex X #k. RevealLTK(X) @k)
   & not (Ex X #k. RevealDH(X) @k)
   & not (Ex X #k. RevealKPK(X) @k)"

/* Secrecy (both roles): root is secret while no key of either party is
 * compromised in any way. */
lemma async_secrecy:
  "All P Q r #i.
     AsyncKey(P, Q, r) @i
   & not (Ex X #j. RevealLTK(X) @j & Honest(X) @i)
   & not (Ex X #j. RevealDH(X) @j  & Honest(X) @i)
   & not (Ex X #j. RevealKPK(X) @j & Honest(X) @i)
   ==> not (Ex #k. K(r) @k)"

/* Responder's view: the root B accepted from A stays secret unless A's
 * X25519 secrets leaked BEFORE B accepted (impersonation window), B's
 * X25519 identity key leaked before B accepted, or B's long-term KEM key
 * leaks at ANY time. A's keys leaking after acceptance do not matter.
 * (Unlike the direct-link handshake, the async flow encapsulates to the
 * LONG-TERM KPK_B and B contributes no ephemeral, so the async root has
 * no forward secrecy against B's long-term keys. SECURITY.md: protection
 * starts at the first reply, via the ratchet, out of scope here.) */
lemma async_secrecy_responder:
  "All A B r #i.
     AsyncAccept(B, A, r) @i
   & not (Ex #j. RevealLTK(A) @j & #j < #i)
   & not (Ex #j. RevealDH(A) @j  & #j < #i)
   & not (Ex #j. RevealDH(B) @j  & #j < #i)
   & not (Ex #j. RevealLTK(B) @j)
   & not (Ex #j. RevealKPK(B) @j)
   ==> not (Ex #k. K(r) @k)"

/* PQ-hybrid, KEM-only: the initiator's root survives a total X25519 break
 * (all identity and ephemeral DH secrets of both parties public) as long
 * as B's long-term KEM private key is not revealed. */
lemma async_kem_only_secrecy:
  "All A B r #i.
     AsyncInit(A, B, r) @i
   & not (Ex #j. RevealLTK(B) @j)
   & not (Ex #j. RevealKPK(B) @j)
   ==> not (Ex #k. K(r) @k)"

/* PQ-hybrid, DH-only: the initiator's root survives a KEM break (B's KEM
 * private key public) and even a full compromise of A's long-term keys,
 * as long as B's identity DH key and A's ephemeral are not revealed. */
lemma async_dh_only_secrecy:
  "All A B r #i.
     AsyncInit(A, B, r) @i
   & not (Ex #j. RevealLTK(B) @j)
   & not (Ex #j. RevealDH(B) @j)
   & not (Ex #j. RevealDH(A) @j)
   ==> not (Ex #k. K(r) @k)"

/* Agreement, both paths: if B accepts (EK_A, kct, root) as coming from A,
 * then A really initiated toward B with exactly those values, provided
 * neither party's X25519 secrets were compromised beforehand. The two
 * roots carry different labels, so a prekey accept can only be matched by
 * a prekey initiation and vice versa. Non-injective: de-duplication of
 * repeated init blocks is done by the ratchet (acceptedInitEph + replay
 * rejection), which is not modelled. */
lemma async_agreement:
  "All A B ekA kct r #i.
     AsyncCommitR(B, A, ekA, kct, r) @i
   & not (Ex X #j. RevealLTK(X) @j & Honest(X) @i & #j < #i)
   & not (Ex X #j. RevealDH(X) @j  & Honest(X) @i & #j < #i)
   ==> Ex #k. AsyncRunningI(A, B, ekA, kct, r) @k & #k < #i"

/* ------------------------------------------------------------------ */
/* Lemmas: one-time prekeys                                            */
/* ------------------------------------------------------------------ */

/* Sanity: the prekey path runs end to end without any compromise. */
lemma async_executable_opk:
  exists-trace
  "Ex A B r pk #i #j.
     AsyncInitOPK(A, B, r, pk) @i & AsyncAcceptOPK(B, A, r, pk) @j & #i < #j
   & not (Ex X #k. RevealLTK(X) @k)
   & not (Ex X #k. RevealDH(X) @k)
   & not (Ex X #k. RevealKPK(X) @k)
   & not (Ex X p #k. RevealOPK(X, p) @k)"

/* Post-quantum forward secrecy of the responder's accepted root when a
 * one-time prekey was used. After acceptance the adversary may obtain
 * every DH secret of both parties (identity and ephemeral, i.e. a break
 * of X25519) and all long-term keys of both parties, and B's long-term
 * KEM key at ANY time, even before; the root stays secret. Only the
 * compromise of either party's X25519 secrets BEFORE acceptance is
 * excluded (impersonation of A, or key-compromise impersonation through
 * IK_B, exactly as in async_secrecy_responder). Compare that lemma: on
 * the fallback path RevealLTK(B) or RevealKPK(B) at any time breaks the
 * root. The prekey's private half cannot leak after use because it no
 * longer exists (the linear OPK fact was consumed on acceptance). */
lemma async_pq_forward_secrecy:
  "All A B r pk #i.
     AsyncAcceptOPK(B, A, r, pk) @i
   & not (Ex #j. RevealLTK(A) @j & #j < #i)
   & not (Ex #j. RevealDH(A) @j  & #j < #i)
   & not (Ex #j. RevealLTK(B) @j & #j < #i)
   & not (Ex #j. RevealDH(B) @j  & #j < #i)
   ==> not (Ex #k. K(r) @k)"

/* Initiator's view, KEM-only: the root A derived to a prekey survives a
 * total X25519 break and the compromise of every long-term key of both
 * parties at any time, as long as that particular prekey's private half
 * was not revealed while it still existed (before B used it). */
lemma async_pq_forward_secrecy_initiator:
  "All A B r pk #i.
     AsyncInitOPK(A, B, r, pk) @i
   & not (Ex #j. RevealOPK(B, pk) @j)
   ==> not (Ex #k. K(r) @k)"

/* ------------------------------------------------------------------ */
/* Lemmas: collision rule                                              */
/* ------------------------------------------------------------------ */

/* Sanity: both parties initiate concurrently, the smaller handle ignores
 * the incoming init, and both end up settled. */
lemma collision_executable:
  exists-trace
  "Ex X Y rX rY r1 r2 #i #j #k #l.
     CInit(X, Y, rX) @i & CInit(Y, X, rY) @j
   & CollisionIgnored(X, Y) @k & Adopted(X, Y, r1) @k
   & Adopted(Y, X, r2) @l
   & #i < #k & #j < #l"

/* Consistency, recovery path included: whenever both parties have
 * settled on a session with each other, they hold the same root.
 *
 * History. Without ignoredInitEphs a stale copy of the loser's init,
 * delivered after the winner had settled, took the recovery path and made
 * the winner replace its session while the loser kept the winner's.
 * ignoredInitEphs alone closed only the ordering in which the winner saw
 * the loser's init (and ignored it) before the loser's first reply; when
 * the reply arrived first, the winner cleared pendingInit without having
 * ignored anything and the stale init still won. The abandoned-init
 * announcement closes that ordering too: the winner can only leave
 * Pending by decrypting a message from the loser, every such message
 * carries the abandoned ephemeral until the loser has proof the winner
 * heard it, so the winner blacklists it no later than the moment it
 * clears pendingInit. Both orderings are covered by this lemma. */
lemma collision_consistency:
  "All X Y r1 r2 #i #j.
     Adopted(X, Y, r1) @i & Adopted(Y, X, r2) @j
   ==> r1 = r2"

/* The announcement mechanism itself: if Y lost a collision against X and
 * abandoned ephemeral e, then by the time X confirms its own session it
 * has blacklisted e. */
lemma abandoned_init_blacklisted:
  "All X Y e r #j #i.
     Abandoned(Y, X, e) @j & Confirmed(X, Y, r) @i
   ==> Ex #k. Ignored(X, Y, e) @k & not (#i < #k)"

/* The previously found trace is gone: an init that its sender abandoned
 * never re-enters through the recovery path at the winner. */
lemma abandoned_init_never_adopted:
  "All X Y e #j #i.
     Abandoned(Y, X, e) @j & Recover(X, Y, e) @i
   ==> F"

end
